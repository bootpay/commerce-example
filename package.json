{
  "name": "bootpay-commerce-example",
  "version": "1.0.0",
  "description": "Bootpay Commerce SDK Example with npm",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --port 5173\" \"node scripts/pages-dev.mjs\"",
    "server": "node --env-file-if-exists=.env.development --env-file-if-exists=.env.local server.js",
    "build": "vite build && node -e \"const f=require('fs');if(f.existsSync('cdn/config.js'))f.copyFileSync('cdn/config.js','dist/cdn/config.js')\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bootpay/backend-js": "2.6.0",
    "@bootpay/bp-commerce-sdk": "^1.0.8",
    "@bootpay/client-js": "^5.5.2",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.97.0"
  }
}
